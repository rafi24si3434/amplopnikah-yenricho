n
<!DOCTYPE html>
<html lang="ikkobbbookd">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Undangan Pernikahan Yenricho Noprian T Silaban & Veni Gracia Br Sitanggang, S.Pd - 03 Oktober 2026">
    <title>Undangan Pernikahan - Yenricho & Veni</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Great+Vibes&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
        rel="stylesheet">

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ==================== COVER / OPENING ==================== -->
    <section id="cover">
        <div class="cover-overlay"></div>
        <div class="floating-petals" id="petals-container"></div>
        <div class="cover-content">
            <div class="cover-ornament-top">
                <svg viewBox="0 0 200 30" class="ornament-svg">
                    <path d="M0,15 Q50,0 100,15 Q150,30 200,15" stroke="currentColor" fill="none" stroke-width="1" />
                    <path d="M0,15 Q50,30 100,15 Q150,0 200,15" stroke="currentColor" fill="none" stroke-width="1" />
                    <circle cx="100" cy="15" r="3" fill="currentColor" />
                    <circle cx="60" cy="10" r="2" fill="currentColor" />
                    <circle cx="140" cy="10" r="2" fill="currentColor" />
                </svg>
            </div>
            <p class="cover-subtitle">The Wedding Of</p>
            <h1 class="cover-names">
                <span class="groom-name-cover">Yenricho</span>
                <span class="ampersand">&</span>
                <span class="bride-name-cover">Veni</span>
            </h1>
            <p class="cover-date">Sabtu, 03 Oktober 2026</p>
            <div class="cover-guest" id="guest-section">
                <p class="guest-label">Kepada Yth.</p>
                <p class="guest-name" id="guest-name">Bapak/Ibu/Saudara/i</p>
            </div>
            <button class="btn-open" id="btn-open-invitation">
                <i data-lucide="mail-open" class="btn-icon"></i>
                <span>Buka Undangan</span>
            </button>
            <div class="cover-ornament-bottom">
                <svg viewBox="0 0 200 30" class="ornament-svg">
                    <path d="M0,15 Q50,0 100,15 Q150,30 200,15" stroke="currentColor" fill="none" stroke-width="1" />
                    <path d="M0,15 Q50,30 100,15 Q150,0 200,15" stroke="currentColor" fill="none" stroke-width="1" />
                    <circle cx="100" cy="15" r="3" fill="currentColor" />
                </svg>
            </div>
        </div>
    </section>

    <!-- ==================== MAIN CONTENT WRAPPER ==================== -->
    <main id="main-content" class="hidden">

        <!-- Music Toggle Button -->
        <button class="music-toggle" id="music-toggle" title="Play/Pause Music">
            <i data-lucide="music" id="music-icon"></i>
        </button>
        <audio id="bg-music" loop>
            <source src="assets/music/wedding-song.mp3" type="audio/mpeg">
        </audio>

        <!-- Navigation -->
        <nav class="floating-nav" id="floating-nav">
            <a href="#home" class="nav-dot active" data-section="home" title="Home"><span></span></a>
            <a href="#couple" class="nav-dot" data-section="couple" title="Mempelai"><span></span></a>
            <a href="#event" class="nav-dot" data-section="event" title="Acara"><span></span></a>
            <a href="#gallery" class="nav-dot" data-section="gallery" title="Galeri"><span></span></a>
            <a href="#location" class="nav-dot" data-section="location" title="Lokasi"><span></span></a>
            <a href="#rsvp" class="nav-dot" data-section="rsvp" title="RSVP"><span></span></a>
            <a href="#wishes" class="nav-dot" data-section="wishes" title="Ucapan"><span></span></a>
        </nav>

        <!-- ==================== HOME / HERO SECTION ==================== -->
        <section id="home" class="section section-dark">
            <div class="hero-bg-image"></div>
            <div class="hero-particles" id="hero-particles"></div>
            <div class="section-content hero-content reveal">
                <div class="ornament-divider">✦</div>
                <p class="script-text">Dengan memohon rahmat dan ridho Tuhan Yang Maha Esa</p>
                <h2 class="section-title hero-title">
                    <span class="groom-full">Yenricho Noprian T Silaban</span>
                    <span class="hero-amp">&</span>
                    <span class="bride-full">Veni Gracia Br Sitanggang, S.Pd</span>
                </h2>
                <div class="bible-verse reveal">
                    <p class="verse-text">"Demikianlah mereka bukan lagi dua, melainkan satu. Karena itu, apa yang telah
                        dipersatukan Allah, tidak boleh diceraikan manusia."</p>
                    <p class="verse-ref">— Matius 19:6 —</p>
                </div>
                <div class="ornament-divider">✦</div>
            </div>
        </section>

        <!-- ==================== COUPLE SECTION ==================== -->
        <section id="couple" class="section section-light">
            <div class="section-content">
                <div class="section-header reveal">
                    <p class="section-label">Mempelai</p>
                    <h2 class="section-title">Calon Pengantin</h2>
                    <div class="ornament-line"></div>
                </div>
                <div class="couple-container">
                    <div class="couple-card reveal reveal-left">
                        <div class="couple-photo-frame">
                            <div class="couple-photo-placeholder">
                                <i data-lucide="user" class="placeholder-icon"></i>
                                <span>Foto Mempelai Pria</span>
                            </div>
                        </div>
                        <div class="couple-info">
                            <h3 class="couple-name script-text">Yenricho Noprian T Silaban</h3>
                            <p class="couple-title">Mempelai Pria</p>
                            <div class="couple-detail">
                                <p>Putra dari</p>
                                <p class="parent-name">Bapak ... & Ibu ...</p>
                            </div>
                        </div>
                    </div>
                    <div class="couple-divider reveal">
                        <div class="heart-icon">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path
                                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                        </div>
                    </div>
                    <div class="couple-card reveal reveal-right">
                        <div class="couple-photo-frame">
                            <div class="couple-photo-placeholder">
                                <i data-lucide="user" class="placeholder-icon"></i>
                                <span>Foto Mempelai Wanita</span>
                            </div>
                        </div>
                        <div class="couple-info">
                            <h3 class="couple-name script-text">Veni Gracia Br Sitanggang, S.Pd</h3>
                            <p class="couple-title">Mempelai Wanita</p>
                            <div class="couple-detail">
                                <p>Putri dari</p>
                                <p class="parent-name">Bapak ... & Ibu ...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== EVENT SECTION ==================== -->
        <section id="event" class="section section-dark">
            <div class="section-content">
                <div class="section-header reveal">
                    <p class="section-label">Waktu & Tempat</p>
                    <h2 class="section-title">Acara Pernikahan</h2>
                    <div class="ornament-line"></div>
                </div>
                <div class="events-container">
                    <!-- Pemberkatan -->
                    <div class="event-card glass-card reveal reveal-left">
                        <div class="event-icon">
                            <i data-lucide="church"></i>
                        </div>
                        <h3 class="event-title">Pemberkatan Nikah</h3>
                        <div class="event-details">
                            <div class="event-detail-item">
                                <i data-lucide="calendar-days"></i>
                                <span>Sabtu, 03 Oktober 2026</span>
                            </div>
                            <div class="event-detail-item">
                                <i data-lucide="clock"></i>
                                <span>10.00 WIB - Selesai</span>
                            </div>
                            <div class="event-detail-item">
                                <i data-lucide="map-pin"></i>
                                <span>Gereja HKBP Dame Ressort Dame Duri</span>
                            </div>
                            <div class="event-detail-item address">
                                <i data-lucide="navigation"></i>
                                <span>Jl. Perdamaian No. 37, Duri</span>
                            </div>
                        </div>
                        <a href="https://maps.google.com/?q=Gereja+HKBP+Dame+Ressort+Dame+Duri+Jl+Perdamaian+No+37"
                            target="_blank" class="btn-maps">
                            <i data-lucide="map"></i>
                            <span>Lihat di Maps</span>
                        </a>
                    </div>
                    <!-- Resepsi -->
                    <div class="event-card glass-card reveal reveal-right">
                        <div class="event-icon">
                            <i data-lucide="party-popper"></i>
                        </div>
                        <h3 class="event-title">Resepsi Pernikahan</h3>
                        <div class="event-details">
                            <div class="event-detail-item">
                                <i data-lucide="calendar-days"></i>
                                <span>Sabtu, 03 Oktober 2026</span>
                            </div>
                            <div class="event-detail-item">
                                <i data-lucide="clock"></i>
                                <span>Setelah Pemberkatan - Selesai</span>
                            </div>
                            <div class="event-detail-item">
                                <i data-lucide="map-pin"></i>
                                <span>Sopo Margurosi</span>
                            </div>
                            <div class="event-detail-item address">
                                <i data-lucide="navigation"></i>
                                <span>Jalan Sejahtera, Duri</span>
                            </div>
                        </div>
                        <a href="https://maps.google.com/?q=Sopo+Margurosi+Jalan+Sejahtera+Duri" target="_blank"
                            class="btn-maps">
                            <i data-lucide="map"></i>
                            <span>Lihat di Maps</span>
                        </a>
                    </div>
                </div>

                <!-- Countdown Timer -->
                <div class="countdown-container reveal">
                    <h3 class="countdown-title">Menghitung Hari</h3>
                    <div class="countdown-timer" id="countdown">
                        <div class="countdown-item">
                            <div class="countdown-number" id="days">00</div>
                            <div class="countdown-label">Hari</div>
                        </div>
                        <div class="countdown-separator">:</div>
                        <div class="countdown-item">
                            <div class="countdown-number" id="hours">00</div>
                            <div class="countdown-label">Jam</div>
                        </div>
                        <div class="countdown-separator">:</div>
                        <div class="countdown-item">
                            <div class="countdown-number" id="minutes">00</div>
                            <div class="countdown-label">Menit</div>
                        </div>
                        <div class="countdown-separator">:</div>
                        <div class="countdown-item">
                            <div class="countdown-number" id="seconds">00</div>
                            <div class="countdown-label">Detik</div>
                        </div>
                    </div>
                    <a href="https://www.google.com/calendar/render?action=TEMPLATE&text=Pernikahan+Yenricho+%26+Veni&dates=20261003T030000Z/20261003T100000Z&details=Pemberkatan+Nikah+di+Gereja+HKBP+Dame+Duri+dan+Resepsi+di+Sopo+Margurosi&location=Gereja+HKBP+Dame+Duri"
                        target="_blank" class="btn-calendar">
                        <i data-lucide="calendar-plus"></i>
                        <span>Simpan ke Kalender</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- ==================== GALLERY SECTION ==================== -->
        <section id="gallery" class="section section-light">
            <div class="section-content">
                <div class="section-header reveal">
                    <p class="section-label">Momen Bahagia</p>
                    <h2 class="section-title">Galeri Foto</h2>
                    <div class="ornament-line"></div>
                </div>
                <div class="gallery-grid reveal">
                    <div class="gallery-item" data-index="0">
                        <img src="assets/images/gallery-1.png" alt="Momen Pernikahan" loading="lazy">
                        <div class="gallery-overlay">
                            <i data-lucide="zoom-in"></i>
                        </div>
                    </div>
                    <div class="gallery-item" data-index="1">
                        <img src="assets/images/hero-bg.png" alt="Dekorasi Pernikahan" loading="lazy">
                        <div class="gallery-overlay">
                            <i data-lucide="zoom-in"></i>
                        </div>
                    </div>
                    <div class="gallery-item" data-index="2">
                        <img src="assets/images/gallery-2.png" alt="Resepsi Pernikahan" loading="lazy">
                        <div class="gallery-overlay">
                            <i data-lucide="zoom-in"></i>
                        </div>
                    </div>
                    <div class="gallery-item" data-index="3">
                        <img src="assets/images/gallery-3.png" alt="Cincin Pernikahan" loading="lazy">
                        <div class="gallery-overlay">
                            <i data-lucide="zoom-in"></i>
                        </div>
                    </div>
                    <div class="gallery-item" data-index="4">
                        <img src="assets/images/couple-bg.png" alt="Pasangan Bahagia" loading="lazy">
                        <div class="gallery-overlay">
                            <i data-lucide="zoom-in"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lightbox -->
            <div class="lightbox" id="lightbox">
                <button class="lightbox-close" id="lightbox-close">
                    <i data-lucide="x"></i>
                </button>
                <button class="lightbox-nav lightbox-prev" id="lightbox-prev">
                    <i data-lucide="chevron-left"></i>
                </button>
                <button class="lightbox-nav lightbox-next" id="lightbox-next">
                    <i data-lucide="chevron-right"></i>
                </button>
                <div class="lightbox-content">
                    <img src="" alt="Gallery" id="lightbox-img">
                </div>
            </div>
        </section>

        <!-- ==================== LOCATION SECTION ==================== -->
        <section id="location" class="section section-dark">
            <div class="section-content">
                <div class="section-header reveal">
                    <p class="section-label">Petunjuk Arah</p>
                    <h2 class="section-title">Lokasi Acara</h2>
                    <div class="ornament-line"></div>
                </div>
                <div class="location-container">
                    <div class="location-card glass-card reveal reveal-left">
                        <h3 class="location-title">
                            <i data-lucide="church"></i>
                            Pemberkatan Nikah
                        </h3>
                        <p class="location-name">Gereja HKBP Dame Ressort Dame Duri</p>
                        <p class="location-address">Jl. Perdamaian No. 37, Duri</p>
                        <div class="map-wrapper">
                            <iframe
                                src="https://maps.google.com/maps?q=Gereja+HKBP+Dame+Ressort+Dame+Duri+Jl+Perdamaian+No+37&t=&z=15&ie=UTF8&iwloc=&output=embed"
                                allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                        <a href="https://maps.google.com/?q=Gereja+HKBP+Dame+Ressort+Dame+Duri+Jl+Perdamaian+No+37"
                            target="_blank" class="btn-direction">
                            <i data-lucide="navigation"></i>
                            Petunjuk Arah
                        </a>
                    </div>
                    <div class="location-card glass-card reveal reveal-right">
                        <h3 class="location-title">
                            <i data-lucide="party-popper"></i>
                            Resepsi Pernikahan
                        </h3>
                        <p class="location-name">Sopo Margurosi</p>
                        <p class="location-address">Jalan Sejahtera, Duri</p>
                        <div class="map-wrapper">
                            <iframe
                                src="https://maps.google.com/maps?q=Sopo+Margurosi+Jalan+Sejahtera+Duri&t=&z=15&ie=UTF8&iwloc=&output=embed"
                                allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                        <a href="https://maps.google.com/?q=Sopo+Margurosi+Jalan+Sejahtera+Duri" target="_blank"
                            class="btn-direction">
                            <i data-lucide="navigation"></i>
                            Petunjuk Arah
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== RSVP SECTION ==================== -->
        <section id="rsvp" class="section section-light">
            <div class="section-content">
                <div class="section-header reveal">
                    <p class="section-label">Konfirmasi</p>
                    <h2 class="section-title">Konfirmasi Kehadiran</h2>
                    <div class="ornament-line"></div>
                </div>
                <div class="rsvp-container reveal">
                    <div class="rsvp-card glass-card-light">
                        <form id="rsvp-form">
                            <div class="form-group">
                                <label for="rsvp-name">Nama Lengkap</label>
                                <div class="input-wrapper">
                                    <i data-lucide="user"></i>
                                    <input type="text" id="rsvp-name" placeholder="Masukkan nama Anda" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Konfirmasi Kehadiran</label>
                                <div class="radio-group">
                                    <label class="radio-option">
                                        <input type="radio" name="attendance" value="hadir" required>
                                        <span class="radio-custom">
                                            <i data-lucide="check-circle"></i>
                                            Hadir
                                        </span>
                                    </label>
                                    <label class="radio-option">
                                        <input type="radio" name="attendance" value="tidak">
                                        <span class="radio-custom">
                                            <i data-lucide="x-circle"></i>
                                            Tidak Hadir
                                        </span>
                                    </label>
                                    <label class="radio-option">
                                        <input type="radio" name="attendance" value="ragu">
                                        <span class="radio-custom">
                                            <i data-lucide="help-circle"></i>
                                            Masih Ragu
                                        </span>
                                    </label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="rsvp-guests">Jumlah Tamu</label>
                                <div class="input-wrapper">
                                    <i data-lucide="users"></i>
                                    <select id="rsvp-guests">
                                        <option value="1">1 Orang</option>
                                        <option value="2" selected>2 Orang</option>
                                        <option value="3">3 Orang</option>
                                        <option value="4">4 Orang</option>
                                        <option value="5">5 Orang</option>
                                    </select>
                                </div>
                            </div>
                            <button type="submit" class="btn-submit" id="btn-rsvp">
                                <i data-lucide="send"></i>
                                <span>Kirim Konfirmasi</span>
                            </button>
                        </form>
                        <div class="rsvp-success hidden" id="rsvp-success">
                            <div class="success-icon">
                                <i data-lucide="heart-handshake"></i>
                            </div>
                            <h3>Terima Kasih!</h3>
                            <p>Konfirmasi kehadiran Anda telah kami terima.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== WISHES SECTION ==================== -->
        <section id="wishes" class="section section-dark">
            <div class="section-content">
                <div class="section-header reveal">
                    <p class="section-label">Ucapan & Doa</p>
                    <h2 class="section-title">Kirim Ucapan</h2>
                    <div class="ornament-line"></div>
                </div>
                <div class="wishes-container">
                    <div class="wishes-form-wrapper reveal">
                        <div class="wishes-form glass-card">
                            <form id="wishes-form">
                                <div class="form-group">
                                    <label for="wish-name">Nama</label>
                                    <div class="input-wrapper">
                                        <i data-lucide="user"></i>
                                        <input type="text" id="wish-name" placeholder="Nama Anda" required>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="wish-message">Ucapan & Doa</label>
                                    <div class="input-wrapper textarea-wrapper">
                                        <i data-lucide="message-circle"></i>
                                        <textarea id="wish-message" rows="4"
                                            placeholder="Tulis ucapan dan doa untuk kedua mempelai..."
                                            required></textarea>
                                    </div>
                                </div>
                                <button type="submit" class="btn-submit">
                                    <i data-lucide="send"></i>
                                    <span>Kirim Ucapan</span>
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="wishes-list-wrapper reveal">
                        <div class="wishes-list" id="wishes-list">
                            <!-- Wishes will be dynamically inserted here -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== FOOTER ==================== -->
        <footer id="footer" class="section-footer">
            <div class="footer-content reveal">
                <div class="footer-ornament">
                    <svg viewBox="0 0 200 30" class="ornament-svg">
                        <path d="M0,15 Q50,0 100,15 Q150,30 200,15" stroke="currentColor" fill="none"
                            stroke-width="1" />
                        <path d="M0,15 Q50,30 100,15 Q150,0 200,15" stroke="currentColor" fill="none"
                            stroke-width="1" />
                    </svg>
                </div>
                <p class="footer-thanks">Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila
                    Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kami.</p>
                <h2 class="footer-names script-text">Yenricho & Veni</h2>
                <p class="footer-hashtag">#YenrichoVeniWedding</p>
                <div class="footer-ornament">
                    <svg viewBox="0 0 200 30" class="ornament-svg">
                        <path d="M0,15 Q50,0 100,15 Q150,30 200,15" stroke="currentColor" fill="none"
                            stroke-width="1" />
                        <path d="M0,15 Q50,30 100,15 Q150,0 200,15" stroke="currentColor" fill="none"
                            stroke-width="1" />
                    </svg>
                </div>
                <p class="footer-copyright">© 2026 Yenricho & Veni Wedding</p>
            </div>
        </footer>

    </main>

    <script src="script.js"></script>
</body>

</html>